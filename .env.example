# Server & Application
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
DEMO_MODE=true

# Database
DATABASE_URL=postgresql://netrabox:netrabox_dev_password@localhost:5432/netrabox

# PayPal Sandbox Configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id
DISPUTES_MODE=internal

# LLM Configuration
LLM_PROVIDER=google
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-1.5-flash

# Cryptographic Keys (Generate with: pnpm keys:generate)
SIGNING_PRIVATE_KEY=your_ed25519_hex_private_key
SIGNING_PUBLIC_KEY=your_ed25519_hex_public_key
